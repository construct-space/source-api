PORT=8010
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost

# Database
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=construct_source
DB_USER=root
DB_PASS=

# Auth — Construct accounts service
ACCOUNTS_URL=https://accounts.lisaos.dev

# Oracle — provider catalog source (admin manages providers/models here)
ORACLE_URL=https://oracle.lisaos.dev

# Service-to-service API key (for operator calls)
SERVICE_API_KEY=

# Email delivery (delivery.lisaos.dev service)
DELIVERY_URL=https://delivery.lisaos.dev
DELIVERY_API_KEY=
EMAIL_FROM=Construct <noreply@lisaos.dev>
APP_URL=https://lisaos.dev

# Feature flags
AI_ENABLED=true
BILLING_ENABLED=true
SPACES_ENABLED=true
MAX_PROJECTS=0

# Added 2026-09-08 from the deployment's keys
DB_SSL=false
DEVELOPER_URL=http://developer
INTEGRATION_URL=https://integration-api.construct.space
OPERATOR_URL=http://operator
